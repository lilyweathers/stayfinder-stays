            ]
          }
        }
      ]
    },
    {
      "name": "21 Deleted property absent",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_publishable_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{rls_access_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{supabase_url}}/rest/v1/properties?property_id=eq.{{rls_property_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200',()=>pm.response.to.have.status(200));",
              "pm.test('No rows visible or changed',()=>pm.expect(pm.response.json()).to.eql([]));",
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Invalidate direct test session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_publishable_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{rls_access_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{supabase_url}}/auth/v1/logout?scope=local"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204',()=>pm.response.to.have.status(204));",
              "if(pm.response.code===204)pm.environment.unset('rls_access_token');",
              "if (pm.response.code !== 204) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    }
  ]
}
