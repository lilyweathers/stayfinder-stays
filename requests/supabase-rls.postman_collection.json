{
  "info": {
    "name": "StayFinder - direct Supabase RLS verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Development only. Use local environment variables supabase_publishable_key, email, password. Never use service_role or secret keys. Run in order and stop on any failed assertion. Creates and deletes temporary records; anonymous requests omit Authorization. No Hono requests. Do not export credentials or tokens."
  },
  "variable": [
    {
      "key": "supabase_url",
      "value": "https://rnvxntbudhvegrhaqijk.supabase.co"
    },
    {
      "key": "rls_property_id",
      "value": ""
    },
    {
      "key": "rls_booking_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Direct login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_publishable_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const token=pm.response.json().access_token;pm.test('Access token received',()=>pm.expect(token).to.be.a('string').and.not.empty);if(token)pm.environment.set('rls_access_token',token);else pm.execution.setNextRequest(null);}",
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Authenticated create property",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_publishable_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{rls_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Prefer",
            "value": "return=representation"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{supabase_url}}/rest/v1/properties",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Temporary direct RLS test\",\n  \"description\": \"Disposable database policy test\",\n  \"location\": \"Stockholm\",\n  \"price_per_night\": 1200,\n  \"max_guests\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201){ const rows=pm.response.json(); pm.test('One inserted row',()=>pm.expect(rows).to.have.lengthOf(1)); if(rows.length===1)pm.collectionVariables.set('rls_property_id',rows[0].property_id); else pm.execution.setNextRequest(null); }",
              "if (pm.response.code !== 201) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
