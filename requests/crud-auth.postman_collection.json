{
  "info": {
    "name": "StayFinder - live CRUD and authentication verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against your development project. Creates one temporary property and booking, verifies CRUD and anonymous denial, then deletes only those records. Stop on any failure; do not continue if fixture IDs were not captured. Use Postman cookies. Set email/password as local environment variables, never commit credentials. These are basic G-level checks, not VG ownership verification."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "crud_property_id",
      "value": ""
    },
    {
      "key": "crud_booking_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Verify session",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Authenticated user returned', () => pm.expect(pm.response.json().user.id).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create temporary property",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/properties",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Temporary CRUD test property\",\n  \"description\": \"Disposable record for API authentication checks\",\n  \"location\": \"Stockholm\",\n  \"price_per_night\": 1200,\n  \"max_guests\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('crud_property_id', pm.response.json().property_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 List properties",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/properties"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Created property appears', () => pm.expect(pm.response.json().some(p => p.property_id === pm.collectionVariables.get('crud_property_id'))).to.eql(true));"
            ]
          }
        }
      ]
    },
